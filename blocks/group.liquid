{% doc %}
  Renders a group of blocks in a row or a column, with alignment, and a gap and padding chosen from the spacing scale.
  Rows wrap on narrow screens, so their children never overflow the viewport.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

{% liquid
  assign gap = '0'
  if block.settings.gap != 'none'
    assign gap = 'var(--' | append: block.settings.gap | append: ')'
  endif

  assign padding = '0'
  if block.settings.padding != 'none'
    assign padding = 'var(--' | append: block.settings.padding | append: ')'
  endif
%}

<div
  class="group {{ block.settings.layout_direction }}"
  style="
    --group-gap: {{ gap }};
    --group-padding: {{ padding }};
    --group-alignment: {{ block.settings.alignment }};
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .group {
    display: flex;
    gap: var(--group-gap);
    width: 100%;
    padding: var(--group-padding);
  }

  .group--horizontal {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: var(--group-alignment);
  }

  .group--vertical {
    flex-direction: column;
    align-items: var(--group-alignment);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.group.name",
  "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }],
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "t:labels.layout_direction",
      "default": "group--vertical",
      "options": [
        { "value": "group--horizontal", "label": "t:options.direction.horizontal" },
        { "value": "group--vertical", "label": "t:options.direction.vertical" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "flex-end", "label": "t:options.alignment.right" }
      ]
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:labels.gap",
      "default": "space-3",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "space-1", "label": "t:options.spacing.space_1" },
        { "value": "space-2", "label": "t:options.spacing.space_2" },
        { "value": "space-3", "label": "t:options.spacing.space_3" },
        { "value": "space-4", "label": "t:options.spacing.space_4" },
        { "value": "space-5", "label": "t:options.spacing.space_5" },
        { "value": "space-6", "label": "t:options.spacing.space_6" }
      ]
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:labels.padding",
      "default": "none",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "space-2", "label": "t:options.spacing.space_2" },
        { "value": "space-3", "label": "t:options.spacing.space_3" },
        { "value": "space-4", "label": "t:options.spacing.space_4" },
        { "value": "space-5", "label": "t:options.spacing.space_5" },
        { "value": "space-6", "label": "t:options.spacing.space_6" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.column",
      "category": "t:general.layout",
      "settings": { "layout_direction": "group--vertical", "alignment": "flex-start", "gap": "space-3" },
      "blocks": [{ "type": "heading" }, { "type": "text" }]
    },
    {
      "name": "t:general.buttons_row",
      "category": "t:general.layout",
      "settings": { "layout_direction": "group--horizontal", "alignment": "flex-start", "gap": "space-3" },
      "blocks": [
        { "type": "button", "settings": { "link": "shopify://collections/all" } },
        {
          "type": "button",
          "settings": {
            "style": "secondary",
            "label": "t:blocks.button.secondary_default",
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
