{% doc %}
  Renders a group of blocks in a row or a column, with configurable gap, alignment and padding.
  Rows wrap on narrow screens, so their children never overflow the viewport.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

<div
  class="group {{ block.settings.layout_direction }}"
  style="
    --group-gap: {{ block.settings.gap }}px;
    --group-padding: {{ block.settings.padding }}px;
    --group-alignment: {{ block.settings.alignment }};
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .group {
    display: flex;
    gap: var(--group-gap);
    width: 100%;
    padding: var(--group-padding);
  }

  .group--horizontal {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: var(--group-alignment);
  }

  .group--vertical {
    flex-direction: column;
    align-items: var(--group-alignment);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.group.name",
  "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }],
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "t:labels.layout_direction",
      "default": "group--vertical",
      "options": [
        { "value": "group--horizontal", "label": "t:options.direction.horizontal" },
        { "value": "group--vertical", "label": "t:options.direction.vertical" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "flex-end", "label": "t:options.alignment.right" }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.gap",
      "default": 16,
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:labels.padding",
      "default": 0,
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:general.column",
      "category": "t:general.layout",
      "settings": { "layout_direction": "group--vertical", "alignment": "flex-start" },
      "blocks": [{ "type": "heading" }, { "type": "text" }]
    },
    {
      "name": "t:general.buttons_row",
      "category": "t:general.layout",
      "settings": { "layout_direction": "group--horizontal", "alignment": "flex-start", "gap": 12 },
      "blocks": [
        { "type": "button", "settings": { "link": "shopify://collections/all" } },
        {
          "type": "button",
          "settings": {
            "style": "secondary",
            "label": "t:blocks.button.secondary_default",
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
