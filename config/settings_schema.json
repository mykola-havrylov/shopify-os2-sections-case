[
  {
    "name": "theme_info",
    "theme_name": "Hearth & Clay",
    "theme_version": "0.1.0",
    "theme_author": "Mykola Havrylov",
    "theme_documentation_url": "https://github.com/mykola-havrylov/shopify-os2-sections-case",
    "theme_support_url": "https://github.com/mykola-havrylov/shopify-os2-sections-case/issues"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "cormorant_n6",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "range",
        "id": "type_body_size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "t:labels.body_size",
        "default": 16
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "t:labels.heading_scale",
        "default": 100
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#F6F1EA"
          },
          {
            "type": "color",
            "id": "foreground",
            "label": "t:labels.foreground",
            "default": "#2B2622"
          },
          {
            "type": "color",
            "id": "muted",
            "label": "t:labels.muted",
            "info": "t:info.muted",
            "default": "#6E655C"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:labels.border",
            "default": "#D9CFC2"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "t:labels.surface",
            "info": "t:info.surface",
            "default": "#EDE5DA"
          },
          {
            "type": "header",
            "content": "t:general.buttons"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:labels.button",
            "default": "#9A5B3C"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:labels.button_label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:labels.secondary_button_label",
            "default": "#2B2622"
          }
        ],
        "role": {
          "background": "background",
          "text": "foreground",
          "links": "foreground",
          "icons": "foreground",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:labels.section_spacing",
        "info": "t:info.section_spacing",
        "default": 64
      }
    ]
  },
  {
    "name": "t:general.style",
    "settings": [
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "t:labels.corner_radius",
        "info": "t:info.corner_radius",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "animations",
        "label": "t:labels.animations",
        "info": "t:info.animations",
        "default": true
      }
    ]
  }
]
