{%- comment -%}
  Main layout: design tokens, font preloading, theme styles, meta tags, header and footer section groups.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}

    {% liquid
      assign preconnect_fonts = false
      unless settings.type_body_font.system?
        assign preconnect_fonts = true
      endunless
      unless settings.type_heading_font.system?
        assign preconnect_fonts = true
      endunless
    %}
    {% if preconnect_fonts %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endif %}

    {% unless settings.type_body_font.system? %}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
