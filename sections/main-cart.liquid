{% comment %}
  Cart page that works without JavaScript: line items with quantity fields and remove links, order note, discounts,
  subtotal, and Update and Check out buttons in one form posted to /cart. It is also the fallback for the cart drawer.
{% endcomment %}

<div class="main-cart section-spacing">
  <h1 class="h2">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form class="main-cart__form" action="{{ routes.cart_url }}" method="post" id="CartForm">
      <ul class="main-cart__items cart-lines" role="list">
        {%- for item in cart.items -%}
          {% render 'cart-line', item: item, id_prefix: 'Cart' %}
        {%- endfor -%}
      </ul>

      <div class="main-cart__footer">
        <div class="field main-cart__note">
          <label class="field__label" for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea class="input" id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
        </div>

        <div class="main-cart__summary">
          {%- for application in cart.cart_level_discount_applications -%}
            <p class="main-cart__row text-small">
              <span>{{ application.title | escape }}</span>
              <span>−{{ application.total_allocated_amount | money }}</span>
            </p>
          {%- endfor -%}
          <p class="main-cart__row main-cart__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </p>
          <p class="text-small text-muted">
            {%- if cart.taxes_included -%}
              {{ 'cart.taxes_included' | t }}
            {%- else -%}
              {{ 'cart.taxes_excluded' | t }}
            {%- endif -%}
          </p>
          <button type="submit" name="update" class="button button--secondary">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="button">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="main-cart__empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="link-arrow" href="{{ routes.all_products_collection_url }}">
        {{- 'cart.continue_shopping' | t -}}
        {% render 'icon', name: 'arrow-right' %}
      </a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .main-cart {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .main-cart__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .main-cart__footer {
    display: grid;
    gap: var(--space-5);
  }

  .main-cart__note {
    max-width: var(--text-measure);
  }

  .main-cart__summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .main-cart__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .main-cart__subtotal {
    font-weight: var(--font-body--weight-bold);
  }

  .main-cart__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  @media (min-width: 750px) {
    .main-cart__footer {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      align-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "settings": []
}
{% endschema %}
