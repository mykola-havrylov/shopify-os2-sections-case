{% doc %}
  Renders the cart link with the item count. The header renders it inside `#cart-icon-bubble`, and the
  `cart-icon-bubble` section renders the same markup for bundled section rendering, so Liquid stays the only source.

  @example
  {% render 'cart-icon-bubble' %}
{% enddoc %}

<a class="cart-icon-bubble" href="{{ routes.cart_url }}">
  {% render 'icon', name: 'cart' %}
  <span class="visually-hidden">{{ 'cart.icon_label' | t: count: cart.item_count }}</span>
  {%- if cart.item_count > 0 -%}
    <span class="cart-icon-bubble__count" aria-hidden="true">{{ cart.item_count | at_most: 99 }}</span>
  {%- endif -%}
</a>

{% stylesheet %}
  .cart-icon-bubble {
    position: relative;
    display: grid;
    place-items: center;
    min-width: var(--control-height);
    min-height: var(--control-height);
    color: inherit;
  }

  .cart-icon-bubble__count {
    position: absolute;
    inset-block-start: var(--space-1);
    inset-inline-end: 0;
    display: grid;
    place-items: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: var(--space-1);
    border-radius: 0.625rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.6875rem;
    line-height: 1;
  }
{% endstylesheet %}
