{% doc %}
  Renders one cart line as an `<li>` for the cart page and the cart drawer: 4:5 thumbnail, title, options, unit price
  with discounts, a quantity field named `updates[<line key>]` and a remove link, and the line total. Without
  JavaScript the quantity field belongs to the cart form and the remove link goes to `item.url_to_remove`; the cart
  drawer script uses `data-line-key` for `change.js`. Place the lines in a `.cart-lines` list, which switches to the
  wide layout from 36rem of its own width.

  @param {object} item - The cart line item
  @param {string} id_prefix - Prefix for element ids, unique per list on the page (`Cart`, `Drawer`)

  @example
  <ul class="cart-lines" role="list">
    {% for item in cart.items %}
      {% render 'cart-line', item: item, id_prefix: 'Cart' %}
    {% endfor %}
  </ul>
{% enddoc %}

{%- liquid
  assign item_title = item.product.title | escape
  assign quantity_id = id_prefix | append: '-Quantity-' | append: item.key
  assign quantity_name = 'updates[' | append: item.key | append: ']'
  assign quantity_label = 'cart.quantity_for' | t: title: item_title
-%}

<li class="cart-line" data-line-key="{{ item.key }}">
  {% render 'image',
    image: item.image,
    ratio: 'product',
    class: 'cart-line__media',
    alt: '',
    placeholder: 'product-1',
    sizes: '8rem'
  %}

  <div class="cart-line__details">
    <a class="cart-line__title" href="{{ item.url }}">{{ item_title }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <p class="text-small text-muted">
        {%- for option in item.options_with_values -%}
          {{ option.name | escape }}: {{ option.value | escape }}
          {%- unless forloop.last %}, {% endunless -%}
        {%- endfor -%}
      </p>
    {%- endunless -%}
    <p class="text-small">
      {{- item.final_price | money -}}
      {%- if item.original_price > item.final_price -%}
        <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
        <s class="price__compare">{{ item.original_price | money }}</s>
      {%- endif -%}
    </p>
    {%- for allocation in item.line_level_discount_allocations -%}
      <p class="text-small text-muted">
        {{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})
      </p>
    {%- endfor -%}
  </div>

  <div class="cart-line__quantity">
    {% render 'quantity-input',
      id: quantity_id,
      name: quantity_name,
      label: quantity_label,
      label_hidden: true,
      value: item.quantity,
      min: 0
    %}
    <a class="cart-line__remove text-small" href="{{ item.url_to_remove }}" data-cart-remove>
      {{- 'cart.remove' | t -}}
      <span class="visually-hidden"> {{ item_title }}</span>
    </a>
  </div>

  <p class="cart-line__total">{{ item.final_line_price | money }}</p>
</li>

{% stylesheet %}
  .cart-lines {
    container-type: inline-size;
    border-block-start: 1px solid var(--color-border);
  }

  .cart-line {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    grid-template-areas:
      'media details total'
      'media quantity quantity';
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-border);
  }

  .cart-line__media {
    grid-area: media;
    align-self: start;
  }

  .cart-line__details {
    grid-area: details;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .cart-line__title {
    text-decoration: none;
  }

  .cart-line__title:hover {
    text-decoration: underline;
  }

  .cart-line__quantity {
    grid-area: quantity;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .cart-line__total {
    grid-area: total;
    text-align: end;
  }

  @container (min-width: 36rem) {
    .cart-line {
      grid-template-columns: 8rem minmax(0, 1fr) auto auto;
      grid-template-areas: 'media details quantity total';
      align-items: start;
      gap: var(--space-5);
    }
  }
{% endstylesheet %}
