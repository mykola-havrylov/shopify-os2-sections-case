{% doc %}
  Renders a decorative line icon as inline SVG (`aria-hidden`, `currentColor` stroke, 1.25em by default).
  Names: cart, account, close, menu, minus, plus, arrow-right, chevron-down, hand, flame, leaf, package, refresh.

  Lucide v1.54.0, ISC, Copyright (c) 2026 Lucide Icons and Contributors; cart, close, minus, plus, arrow-right and
  chevron-down derived from Feather, MIT, Copyright (c) 2013-present Cole Bemis. See docs/third-party-assets.md.

  @param {string} name - Icon name
  @param {string} [class] - Extra class for the `svg` element

  @example
  {% render 'icon', name: 'arrow-right' %}
{% enddoc %}

{%- capture paths -%}
  {%- case name -%}
    {%- when 'cart' -%}
      <path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.103 6.034h17.794"/><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/>
    {%- when 'account' -%}
      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
    {%- when 'close' -%}
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'plus' -%}
      <path d="M5 12h14"/><path d="M12 5v14"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
    {%- when 'menu' -%}
      <path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'hand' -%}
      <path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"/><path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
    {%- when 'flame' -%}
      <path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4"/>
    {%- when 'leaf' -%}
      <path d="M11 20a10 10 0 0010-10 25.9 25.9 0 00-1.04-7.281 1 1 0 00-1.755-.325C15.833 5.5 13 5.5 9.8 6.1A7 7 0 0011 20"/><path d="M2 21a5 5 0 012.911-4.544C7.613 15.212 8.351 15.24 11 13"/>
    {%- when 'package' -%}
      <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><path d="m7.5 4.27 9 5.15"/>
    {%- when 'refresh' -%}
      <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>
  {%- endcase -%}
{%- endcapture -%}

{%- if paths != blank -%}
  <svg
    class="icon icon--{{ name }} {{ class }}"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {{- paths -}}
  </svg>
{%- endif -%}

{% stylesheet %}
  .icon {
    flex-shrink: 0;
    width: 1.25em;
    height: 1.25em;
    stroke-width: var(--icon-stroke-width);
  }
{% endstylesheet %}
