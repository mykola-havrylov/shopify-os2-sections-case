{% doc %}
  Renders a responsive image with `srcset`, `sizes` and `width`/`height` attributes, optionally wrapped in a link and
  cropped to a ratio with CSS (the crop follows the admin focal point). The frame has the scheme's surface color and the
  global radius; a blank image renders a placeholder. Only the page's LCP image gets `loading: 'eager'` and
  `fetchpriority: 'high'`.

  @param {image} image - The image to render
  @param {string} [url] - Wraps the image in a link to this URL
  @param {string} [class] - Extra class for the wrapper
  @param {string} [alt] - Alt text; defaults to the image's alt text. Pass an empty string for a decorative image
  @param {string} [sizes] - The `sizes` attribute; defaults to `100vw`
  @param {string} [widths] - Comma-separated `srcset` widths; defaults to `360, 540, 720, 900, 1080, 1440, 1800`
  @param {string} [loading] - `lazy` (default) or `eager`
  @param {string} [fetchpriority] - `high` for the LCP image, otherwise leave empty
  @param {string} [ratio] - Crop to a theme ratio token: `product` (4:5), `tile` (4:5) or `hero` (4:5 mobile, 16:9 desktop)
  @param {string} [aspect_ratio] - Crop to any CSS aspect ratio such as `16 / 9`; ignored when `ratio` is set
  @param {string} [placeholder] - `placeholder_svg_tag` name used when `image` is blank; defaults to `image`
  @param {number} [width] - Maximum width of the largest file; defaults to the image width
  @param {number} [height] - Maximum height of the largest file
  @param {string} [crop] - Shopify CDN crop position when both width and height are set

  @example
  {% render 'image', image: product.featured_image, ratio: 'product', sizes: '(min-width: 750px) 33vw, 50vw' %}
  {% render 'image',
    image: section.settings.image,
    sizes: '100vw',
    loading: 'eager',
    fetchpriority: 'high',
    ratio: 'hero',
  %}
{% enddoc %}

{% liquid
  unless height
    assign width = width | default: image.width
  endunless

  assign image_sizes = sizes | default: '100vw'
  assign image_widths = widths | default: '360, 540, 720, 900, 1080, 1440, 1800'
  assign image_loading = loading | default: 'lazy'

  assign image_ratio = aspect_ratio
  if ratio != blank
    assign image_ratio = 'var(--ratio-' | append: ratio | append: ')'
  endif

  if alt == null
    assign image_alt = image.alt
  else
    assign image_alt = alt
  endif

  if url
    assign wrapper = 'a'
  else
    assign wrapper = 'div'
  endif
%}

<{{ wrapper }}
  class="image{% if image_ratio %} image--cropped{% endif %} {{ class }}"
  {% if image_ratio %}
    style="--image-aspect-ratio: {{ image_ratio }};"
  {% endif %}
  {% if url %}
    href="{{ url }}"
  {% endif %}
>
  {%- if image == blank -%}
    {{ placeholder | default: 'image' | placeholder_svg_tag: 'image__placeholder' }}
  {%- elsif fetchpriority == 'high' -%}
    {{
      image
      | image_url: width: width, height: height, crop: crop
      | image_tag:
        widths: image_widths,
        sizes: image_sizes,
        loading: image_loading,
        fetchpriority: 'high',
        alt: image_alt
    }}
  {%- else -%}
    {{
      image
      | image_url: width: width, height: height, crop: crop
      | image_tag: widths: image_widths, sizes: image_sizes, loading: image_loading, alt: image_alt
    }}
  {%- endif -%}
</{{ wrapper }}>

{% stylesheet %}
  .image {
    display: block;
    position: relative;
    overflow: hidden;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background-color: var(--color-surface);
  }

  .image > img {
    width: 100%;
    height: auto;
  }

  .image--cropped {
    aspect-ratio: var(--image-aspect-ratio);
  }

  .image--cropped > img,
  .image--cropped > .image__placeholder {
    height: 100%;
    object-fit: cover;
  }

  .image__placeholder {
    width: 100%;
    height: auto;
    fill: var(--color-muted);
    opacity: 0.4;
  }
{% endstylesheet %}
