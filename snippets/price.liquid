{% doc %}
  Renders a product price: "From" the lowest price when variant prices differ, and the compare-at price struck through
  when it is higher than the price. Screen readers get "Sale price" and "Regular price" labels.

  @param {product} product - The product
  @param {string} [class] - Extra class for the wrapper

  @example
  {% render 'price', product: product, class: 'product-card__price' %}
{% enddoc %}

{%- liquid
  assign price = product.price | money
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<p class="price {{ class }}">
  {%- if product.price_varies -%}
    {%- assign price_min = product.price_min | money -%}
    {{ 'products.price_from' | t: price: price_min }}
  {%- elsif on_sale -%}
    <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
    {{ price }}
    <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
    <s class="price__compare">{{ product.compare_at_price | money }}</s>
  {%- else -%}
    {{ price }}
  {%- endif -%}
</p>

{% stylesheet %}
  .price__compare {
    margin-inline-start: var(--space-2);
    color: var(--color-muted);
  }
{% endstylesheet %}
