{% doc %}
  Renders a product card: 4:5 image on the surface color, title and price, and a "Sold out" badge when no variant is
  available. The title link covers the whole card. Styles are in `assets/components.css`.

  @param {product} product - The product
  @param {string} [heading_tag] - Title element, `h2` or `h3` (default) to fit the page outline
  @param {string} [sizes] - The image `sizes` attribute
  @param {string} [loading] - Image loading, `lazy` (default) or `eager`
  @param {string} [fetchpriority] - `high` only when the card image is the page's LCP image

  @example
  {% render 'product-card', product: product, heading_tag: 'h2', sizes: '(min-width: 750px) 33vw, 50vw' %}
{% enddoc %}

{%- assign title_tag = heading_tag | default: 'h3' -%}

<div class="product-card">
  {% render 'image',
    image: product.featured_image,
    ratio: 'product',
    class: 'product-card__media',
    alt: '',
    placeholder: 'product-1',
    sizes: sizes,
    loading: loading,
    fetchpriority: fetchpriority
  %}
  {%- unless product.available -%}
    <span class="badge product-card__badge">{{ 'products.sold_out' | t }}</span>
  {%- endunless -%}
  <div class="product-card__info">
    <{{ title_tag }} class="product-card__title">
      <a class="product-card__link" href="{{ product.url }}">{{ product.title | escape }}</a>
    </{{ title_tag }}>
    {% render 'price', product: product, class: 'product-card__price' %}
  </div>
</div>
